# Autenticação GCP — PREFERIDO (Application Default Credentials, sem variável):
#   gcloud auth application-default login
# Alternativa (somente se ADC não for possível): JSON de service account FORA deste repositório.
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/fora/do/repo/meu-arquivo-service-account.json

GCP_PROJECT_ID=meu-projeto-ipb-mba
BIGQUERY_DATASET=ipb_staging
BIGQUERY_LOCATION=US

# Bucket GCS com os arquivos das fontes manuais (PIB, Estban, Anatel) — ver Diretriz 0.7 do AGENTS.md.
# Os caminhos data/ são derivados no src/config.py e NÃO são lidos de variáveis de ambiente.
GCS_BUCKET_NAME=ipb-raw-data-mba-projetc-final
